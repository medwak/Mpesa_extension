{
  "manifest_version": 3,
  "name": "M-Pesa Ledger – Accounting, Statements & Budgets",
  "short_name": "M-Pesa Ledger",
  "version": "1.0.0",
  "description": "Turn your M-Pesa messages and statements into accounts, printable statements and monthly budgets. All data stays on your device.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "M-Pesa Ledger",
    "default_popup": "src/ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/ui/dashboard.html",
  "permissions": ["storage", "unlimitedStorage", "contextMenus"]
}
